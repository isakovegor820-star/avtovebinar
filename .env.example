NODE_ENV=development
PORT=5174
PUBLIC_SITE_URL=http://127.0.0.1:5174
DATABASE_URL=postgresql://aspb:aspb@localhost:5432/aspb_autowebinar?schema=public

ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
ADMIN_COOKIE_SECRET=replace-with-long-random-secret
IP_HASH_SECRET=replace-with-long-random-secret

EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="АСПБ <no-reply@aspb.local>"

TELEGRAM_GROUP_URL=https://t.me/example

# Бот для менеджера: получает новые регистрации, вопросы и заявки.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_BOT_POLLING=off
TELEGRAM_NOTIFY_MODE=log

# Legacy fallback. Лучше не использовать для нового запуска, оставлено для совместимости.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_POLLING=off

# Бот для участников: /start по персональной ссылке, новости и напоминания.
TELEGRAM_PARTICIPANT_BOT_TOKEN=
TELEGRAM_PARTICIPANT_BOT_USERNAME=
TELEGRAM_PARTICIPANT_BOT_POLLING=off

# 5 новостных/полезных Telegram-выпусков в день для подключенных участников.
TELEGRAM_NEWS_BROADCAST=off
TELEGRAM_NEWS_TIMES=09:00,11:30,14:00,16:30,19:00
TELEGRAM_NEWS_RSS_URLS=https://www.consultant.ru/rss/hotdocs.xml,https://www.consultant.ru/rss/nw.xml,https://www.consultant.ru/rss/db.xml
CORS_ORIGIN=http://127.0.0.1:5174
