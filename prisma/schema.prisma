generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         String     @default("manager")
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  auditLogs    AuditLog[]
  assignedRegistrations Registration[]
  assignedPartnerApplications PartnerApplication[]

  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?    @map("admin_user_id")
  action      String
  entityType  String     @map("entity_type")
  entityId    String?    @map("entity_id")
  beforeJson  Json?      @map("before_json")
  afterJson   Json?      @map("after_json")
  ipHash      String?    @map("ip_hash")
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Lead {
  id                 String         @id @default(cuid())
  name               String
  phone              String
  email              String         @unique
  city               String?
  professionalStatus String?        @map("professional_status")
  consent            Boolean        @default(false)
  source             String?
  utmSource          String?        @map("utm_source")
  utmMedium          String?        @map("utm_medium")
  utmCampaign        String?        @map("utm_campaign")
  utmContent         String?        @map("utm_content")
  utmTerm            String?        @map("utm_term")
  telegramChatId     String?        @map("telegram_chat_id")
  telegramUsername   String?        @map("telegram_username")
  telegramFirstName  String?        @map("telegram_first_name")
  telegramSubscribedAt DateTime?    @map("telegram_subscribed_at")
  firstSeenAt        DateTime       @default(now()) @map("first_seen_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  registrations      Registration[]
  questions          Question[]
  events             Event[]
  partnerApplications PartnerApplication[]

  @@index([phone])
  @@index([telegramChatId])
  @@index([createdAt])
  @@map("leads")
}

model WebinarSession {
  id              String         @id @default(cuid())
  title           String
  scheduledAt     DateTime       @map("scheduled_at")
  durationMinutes Int            @default(120) @map("duration_minutes")
  videoUrl        String?        @map("video_url")
  posterUrl       String?        @map("poster_url")
  videoDurationSeconds Int       @default(568) @map("video_duration_seconds")
  roomOpenBeforeMinutes Int      @default(15) @map("room_open_before_minutes")
  replayAvailableHours Int       @default(48) @map("replay_available_hours")
  replayEnabled   Boolean        @default(true) @map("replay_enabled")
  liveMode        String         @default("simulated") @map("live_mode")
  status          String         @default("scheduled")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  registrations   Registration[]
  questions       Question[]
  events          Event[]
  partnerApplications PartnerApplication[]
  timelineEvents  WebinarTimelineEvent[]

  @@unique([scheduledAt])
  @@index([status])
  @@map("webinar_sessions")
}

model Registration {
  id               String         @id @default(cuid())
  leadId           String         @map("lead_id")
  webinarSessionId String         @map("webinar_session_id")
  accessTokenHash  String         @unique @map("access_token_hash")
  registeredAt     DateTime       @default(now()) @map("registered_at")
  successViewedAt  DateTime?      @map("success_viewed_at")
  roomEnteredAt    DateTime?      @map("room_entered_at")
  telegramClickedAt DateTime?     @map("telegram_clicked_at")
  emailSentAt      DateTime?      @map("email_sent_at")
  reminderSentAt   DateTime?      @map("reminder_sent_at")
  confirmationSentAt DateTime?    @map("confirmation_sent_at")
  reminder24hSentAt DateTime?     @map("reminder_24h_sent_at")
  reminder3hSentAt DateTime?      @map("reminder_3h_sent_at")
  reminder30mSentAt DateTime?     @map("reminder_30m_sent_at")
  telegramReminder24hSentAt DateTime? @map("telegram_reminder_24h_sent_at")
  telegramReminder3hSentAt DateTime?  @map("telegram_reminder_3h_sent_at")
  telegramReminder30mSentAt DateTime? @map("telegram_reminder_30m_sent_at")
  telegramFollowupSentAt DateTime? @map("telegram_followup_sent_at")
  status           String         @default("registered")
  crmStatus        String         @default("new") @map("crm_status")
  isHot            Boolean        @default(false) @map("is_hot")
  assignedManagerId String?       @map("assigned_manager_id")
  nextContactAt    DateTime?      @map("next_contact_at")
  managerNote      String?        @map("manager_note")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  webinarSession   WebinarSession @relation(fields: [webinarSessionId], references: [id], onDelete: Cascade)
  assignedManager  AdminUser?     @relation(fields: [assignedManagerId], references: [id], onDelete: SetNull)
  questions        Question[]
  events           Event[]
  partnerApplications PartnerApplication[]
  tokens           RegistrationToken[]

  @@index([leadId])
  @@index([webinarSessionId])
  @@index([registeredAt])
  @@index([crmStatus])
  @@index([isHot])
  @@index([assignedManagerId])
  @@index([nextContactAt])
  @@map("registrations")
}

model RegistrationToken {
  id             String       @id @default(cuid())
  registrationId String       @map("registration_id")
  tokenHash      String       @unique @map("token_hash")
  purpose        String       @default("access")
  expiresAt      DateTime?    @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([purpose])
  @@map("registration_tokens")
}

model Question {
  id               String         @id @default(cuid())
  leadId           String         @map("lead_id")
  registrationId   String         @map("registration_id")
  webinarSessionId String         @map("webinar_session_id")
  text             String
  isAnswered       Boolean        @default(false) @map("is_answered")
  adminNote        String?        @map("admin_note")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  registration     Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  webinarSession   WebinarSession @relation(fields: [webinarSessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isAnswered])
  @@map("questions")
}

model Event {
  id               String          @id @default(cuid())
  eventName        String          @map("event_name")
  leadId           String?         @map("lead_id")
  registrationId   String?         @map("registration_id")
  webinarSessionId String?         @map("webinar_session_id")
  page             String?
  source           String?
  utmSource        String?         @map("utm_source")
  utmMedium        String?         @map("utm_medium")
  utmCampaign      String?         @map("utm_campaign")
  userAgent        String?         @map("user_agent")
  ipHash           String?         @map("ip_hash")
  metadataJson     Json?           @map("metadata_json")
  createdAt        DateTime        @default(now()) @map("created_at")
  lead             Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  registration     Registration?   @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  webinarSession   WebinarSession? @relation(fields: [webinarSessionId], references: [id], onDelete: SetNull)

  @@index([eventName])
  @@index([createdAt])
  @@index([registrationId])
  @@map("events")
}

model PartnerApplication {
  id               String          @id @default(cuid())
  leadId           String          @map("lead_id")
  registrationId   String?         @map("registration_id")
  webinarSessionId String?         @map("webinar_session_id")
  sphere           String?
  city             String?
  clientFlow       String?         @map("client_flow")
  experience       String?
  comment          String?
  preferredFormat  String?         @map("preferred_format")
  status           String          @default("new")
  assignedManagerId String?        @map("assigned_manager_id")
  nextContactAt    DateTime?       @map("next_contact_at")
  contractSentAt   DateTime?       @map("contract_sent_at")
  contractSignedAt DateTime?       @map("contract_signed_at")
  lostReason       String?         @map("lost_reason")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  registration     Registration?   @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  webinarSession   WebinarSession? @relation(fields: [webinarSessionId], references: [id], onDelete: SetNull)
  assignedManager  AdminUser?      @relation(fields: [assignedManagerId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([registrationId])
  @@index([status])
  @@index([assignedManagerId])
  @@index([nextContactAt])
  @@index([createdAt])
  @@map("partner_applications")
}

model WebinarTimelineEvent {
  id               String          @id @default(cuid())
  webinarSessionId String?         @map("webinar_session_id")
  offsetSeconds    Int             @map("offset_seconds")
  title            String
  text             String
  type             String          @default("message")
  ctaLabel         String?         @map("cta_label")
  ctaUrl           String?         @map("cta_url")
  createdAt        DateTime        @default(now()) @map("created_at")
  webinarSession   WebinarSession? @relation(fields: [webinarSessionId], references: [id], onDelete: Cascade)

  @@index([webinarSessionId])
  @@index([offsetSeconds])
  @@map("webinar_timeline_events")
}

model TelegramNewsPost {
  id             String   @id @default(cuid())
  postKey        String   @unique @map("post_key")
  slotKey        String   @map("slot_key")
  title          String
  summary        String?
  url            String?
  sourceTitle    String?  @map("source_title")
  recipientCount Int      @default(0) @map("recipient_count")
  sentAt         DateTime @default(now()) @map("sent_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([slotKey])
  @@index([sentAt])
  @@map("telegram_news_posts")
}
