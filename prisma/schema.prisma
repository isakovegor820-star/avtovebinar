generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                          String                 @id @default(cuid())
  name                        String
  email                       String                 @unique
  passwordHash                String                 @map("password_hash")
  role                        String                 @default("manager")
  isActive                    Boolean                @default(true) @map("is_active")
  mfaSecretEncrypted          String?                @map("mfa_secret_encrypted")
  mfaEnabledAt                DateTime?              @map("mfa_enabled_at")
  sessionVersion              Int                    @default(1) @map("session_version")
  lastLoginAt                 DateTime?              @map("last_login_at")
  createdAt                   DateTime               @default(now()) @map("created_at")
  updatedAt                   DateTime               @updatedAt @map("updated_at")
  auditLogs                   AuditLog[]
  assignedRegistrations       Registration[]
  assignedPartnerApplications PartnerApplication[]
  telegramBroadcastJobs       TelegramBroadcastJob[]

  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?    @map("admin_user_id")
  action      String
  entityType  String     @map("entity_type")
  entityId    String?    @map("entity_id")
  beforeJson  Json?      @map("before_json")
  afterJson   Json?      @map("after_json")
  ipHash      String?    @map("ip_hash")
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Lead {
  id                                 String                       @id @default(cuid())
  name                               String
  phone                              String
  email                              String                       @unique
  city                               String?
  professionalStatus                 String?                      @map("professional_status")
  consent                            Boolean                      @default(false)
  marketingConsent                   Boolean                      @default(false) @map("marketing_consent")
  marketingEmailConsent              Boolean                      @default(false) @map("marketing_email_consent")
  marketingTelegramConsent           Boolean                      @default(false) @map("marketing_telegram_consent")
  consentAt                          DateTime?                    @map("consent_at")
  marketingConsentAt                 DateTime?                    @map("marketing_consent_at")
  marketingEmailConsentAt            DateTime?                    @map("marketing_email_consent_at")
  marketingTelegramConsentAt         DateTime?                    @map("marketing_telegram_consent_at")
  consentPolicyVersion               String?                      @map("consent_policy_version")
  consentIpHash                      String?                      @map("consent_ip_hash")
  consentRevokedAt                   DateTime?                    @map("consent_revoked_at")
  personalDataConsentRevokedAt       DateTime?                    @map("personal_data_consent_revoked_at")
  personalDataRevocationChannel      String?                      @map("personal_data_revocation_channel")
  personalDataRevocationReason       String?                      @map("personal_data_revocation_reason")
  marketingEmailRevokedAt            DateTime?                    @map("marketing_email_revoked_at")
  marketingEmailRevocationChannel    String?                      @map("marketing_email_revocation_channel")
  marketingEmailRevocationReason     String?                      @map("marketing_email_revocation_reason")
  marketingTelegramRevokedAt         DateTime?                    @map("marketing_telegram_revoked_at")
  marketingTelegramRevocationChannel String?                      @map("marketing_telegram_revocation_channel")
  marketingTelegramRevocationReason  String?                      @map("marketing_telegram_revocation_reason")
  source                             String?
  utmSource                          String?                      @map("utm_source")
  utmMedium                          String?                      @map("utm_medium")
  utmCampaign                        String?                      @map("utm_campaign")
  utmContent                         String?                      @map("utm_content")
  utmTerm                            String?                      @map("utm_term")
  telegramChatId                     String?                      @map("telegram_chat_id")
  telegramUsername                   String?                      @map("telegram_username")
  telegramFirstName                  String?                      @map("telegram_first_name")
  telegramSubscribedAt               DateTime?                    @map("telegram_subscribed_at")
  telegramBindingVersion             String?                      @map("telegram_binding_version")
  firstSeenAt                        DateTime                     @default(now()) @map("first_seen_at")
  createdAt                          DateTime                     @default(now()) @map("created_at")
  updatedAt                          DateTime                     @updatedAt @map("updated_at")
  registrations                      Registration[]
  questions                          Question[]
  events                             Event[]
  partnerApplications                PartnerApplication[]
  consentRecords                     ConsentRecord[]
  legalAcceptances                   LegalAcceptance[]
  telegramBroadcastRecipients        TelegramBroadcastRecipient[]

  @@index([phone])
  @@index([telegramChatId])
  @@index([createdAt])
  @@map("leads")
}

model WebinarSession {
  id                    String                 @id @default(cuid())
  title                 String
  scheduledAt           DateTime               @map("scheduled_at")
  durationMinutes       Int                    @default(65) @map("duration_minutes")
  videoUrl              String?                @map("video_url")
  posterUrl             String?                @map("poster_url")
  videoDurationSeconds  Int                    @default(3860) @map("video_duration_seconds")
  roomOpenBeforeMinutes Int                    @default(15) @map("room_open_before_minutes")
  replayAvailableHours  Int                    @default(168) @map("replay_available_hours")
  replayEnabled         Boolean                @default(true) @map("replay_enabled")
  liveMode              String                 @default("simulated") @map("live_mode")
  status                String                 @default("scheduled")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  registrations         Registration[]
  questions             Question[]
  events                Event[]
  partnerApplications   PartnerApplication[]
  timelineEvents        WebinarTimelineEvent[]
  chatMessages          WebinarChatMessage[]
  emailOutboxJobs       EmailOutboxJob[]
  recordings            WebinarRecording[]

  @@unique([scheduledAt])
  @@index([status])
  @@map("webinar_sessions")
}

model WebinarRecording {
  id               String         @id @default(cuid())
  webinarSessionId String         @map("webinar_session_id")
  title            String
  description      String?
  posterUrl        String?        @map("poster_url")
  videoUrl         String?        @map("video_url")
  hlsUrl           String?        @map("hls_url")
  durationSeconds  Int?           @map("duration_seconds")
  publishedAt      DateTime?      @map("published_at")
  visible          Boolean        @default(false)
  orderIndex       Int            @default(0) @map("order_index")
  category         String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  webinarSession   WebinarSession @relation(fields: [webinarSessionId], references: [id], onDelete: Cascade)

  @@index([webinarSessionId])
  @@index([visible, publishedAt, orderIndex])
  @@index([category])
  @@map("webinar_recordings")
}

model Registration {
  id                                  String               @id @default(cuid())
  leadId                              String               @map("lead_id")
  webinarSessionId                    String               @map("webinar_session_id")
  accessTokenHash                     String               @unique @map("access_token_hash")
  registeredAt                        DateTime             @default(now()) @map("registered_at")
  emailVerifiedAt                     DateTime?            @map("email_verified_at")
  pendingMetadataJson                 Json?                @map("pending_metadata_json")
  successViewedAt                     DateTime?            @map("success_viewed_at")
  roomEnteredAt                       DateTime?            @map("room_entered_at")
  telegramClickedAt                   DateTime?            @map("telegram_clicked_at")
  emailSentAt                         DateTime?            @map("email_sent_at")
  reminderSentAt                      DateTime?            @map("reminder_sent_at")
  confirmationSentAt                  DateTime?            @map("confirmation_sent_at")
  reminder24hSentAt                   DateTime?            @map("reminder_24h_sent_at")
  reminder3hSentAt                    DateTime?            @map("reminder_3h_sent_at")
  reminder30mSentAt                   DateTime?            @map("reminder_30m_sent_at")
  telegramReminder24hSentAt           DateTime?            @map("telegram_reminder_24h_sent_at")
  telegramReminder3hSentAt            DateTime?            @map("telegram_reminder_3h_sent_at")
  telegramReminder30mSentAt           DateTime?            @map("telegram_reminder_30m_sent_at")
  telegramLiveSentAt                  DateTime?            @map("telegram_live_sent_at")
  telegramFollowupSentAt              DateTime?            @map("telegram_followup_sent_at")
  telegramReminder24hClaimedUntil     DateTime?            @map("telegram_reminder_24h_claimed_until")
  telegramReminder3hClaimedUntil      DateTime?            @map("telegram_reminder_3h_claimed_until")
  telegramReminder30mClaimedUntil     DateTime?            @map("telegram_reminder_30m_claimed_until")
  telegramLiveClaimedUntil            DateTime?            @map("telegram_live_claimed_until")
  telegramFollowupClaimedUntil        DateTime?            @map("telegram_followup_claimed_until")
  status                              String               @default("registered")
  crmStatus                           String               @default("new") @map("crm_status")
  isHot                               Boolean              @default(false) @map("is_hot")
  chatBannedAt                        DateTime?            @map("chat_banned_at")
  assignedManagerId                   String?              @map("assigned_manager_id")
  nextContactAt                       DateTime?            @map("next_contact_at")
  managerNote                         String?              @map("manager_note")
  createdAt                           DateTime             @default(now()) @map("created_at")
  updatedAt                           DateTime             @updatedAt @map("updated_at")
  lead                                Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  webinarSession                      WebinarSession       @relation(fields: [webinarSessionId], references: [id], onDelete: Cascade)
  assignedManager                     AdminUser?           @relation(fields: [assignedManagerId], references: [id], onDelete: SetNull)
  questions                           Question[]
  events                              Event[]
  partnerApplications                 PartnerApplication[]
  tokens                              RegistrationToken[]
  chatMessages                        WebinarChatMessage[]
  emailOutboxJobs                     EmailOutboxJob[]
  consentRecords                      ConsentRecord[]
  legalAcceptances                    LegalAcceptance[]

  @@unique([leadId, webinarSessionId])
  @@index([leadId])
  @@index([webinarSessionId])
  @@index([registeredAt])
  @@index([status, emailVerifiedAt])
  @@index([crmStatus])
  @@index([isHot])
  @@index([assignedManagerId])
  @@index([nextContactAt])
  @@map("registrations")
}

model RegistrationToken {
  id             String       @id @default(cuid())
  registrationId String       @map("registration_id")
  tokenHash      String       @unique @map("token_hash")
  purpose        String       @default("access")
  expiresAt      DateTime?    @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([purpose])
  @@map("registration_tokens")
}

model EmailOutboxJob {
  id               String          @id @default(cuid())
  type             String
  status           String          @default("pending")
  registrationId   String?         @map("registration_id")
  webinarSessionId String?         @map("webinar_session_id")
  toEmail          String          @map("to_email")
  toName           String          @map("to_name")
  scheduledAt      DateTime        @map("scheduled_at")
  webinarUrl       String          @map("webinar_url")
  partnerUrl       String?         @map("partner_url")
  reminderKind     String?         @map("reminder_kind")
  attempts         Int             @default(0)
  lastError        String?         @map("last_error")
  nextAttemptAt    DateTime?       @map("next_attempt_at")
  sentAt           DateTime?       @map("sent_at")
  claimToken       String?         @unique @map("claim_token")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  registration     Registration?   @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  webinarSession   WebinarSession? @relation(fields: [webinarSessionId], references: [id], onDelete: SetNull)

  // Идемпотентность напоминаний: не больше одной email-джобы на (регистрация, тип, вид
  // напоминания). NULL reminder_kind (не-reminder джобы) в Postgres считаются различными,
  // поэтому ограничение реально дедупит только напоминания (24h/3h/30m).
  @@unique([registrationId, type, reminderKind])
  @@index([status, nextAttemptAt, createdAt])
  @@index([registrationId])
  @@index([webinarSessionId])
  @@index([type])
  @@map("email_outbox_jobs")
}

model EmailOutboxDeadLetter {
  id          String   @id @default(cuid())
  jobId       String   @unique @map("job_id")
  reason      String
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("email_outbox_dead_letters")
}

model WorkerSubsystemHealth {
  subsystem     String   @id
  lastProgressAt DateTime @map("last_progress_at")
  deadlineAt     DateTime @map("deadline_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([deadlineAt])
  @@map("worker_subsystem_health")
}

model TelegramBroadcastJob {
  id                     String                       @id @default(cuid())
  status                 String                       @default("pending")
  kind                   String                       @default("marketing_telegram")
  text                   String
  chatIds                Json                         @map("chat_ids")
  recipientSnapshot      Json?                        @map("recipient_snapshot")
  consentDocumentId      String?                      @map("consent_document_id")
  consentDocumentVersion String?                      @map("consent_document_version")
  initiatedById          String?                      @map("initiated_by_id")
  idempotencyKey         String?                      @unique @map("idempotency_key")
  total                  Int
  sent                   Int                          @default(0)
  failed                 Int                          @default(0)
  attempts               Int                          @default(0)
  nextIndex              Int                          @default(0) @map("next_index")
  lastError              String?                      @map("last_error")
  nextAttemptAt          DateTime?                    @map("next_attempt_at")
  claimToken             String?                      @unique @map("claim_token")
  startedAt              DateTime?                    @map("started_at")
  completedAt            DateTime?                    @map("completed_at")
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  initiatedBy            AdminUser?                   @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  recipients             TelegramBroadcastRecipient[]

  @@index([status, nextAttemptAt, createdAt])
  @@index([createdAt])
  @@index([initiatedById])
  @@map("telegram_broadcast_jobs")
}

model TelegramBroadcastRecipient {
  id                       String               @id @default(cuid())
  jobId                    String               @map("job_id")
  leadId                   String?              @map("lead_id")
  chatId                   String               @map("chat_id")
  consentRecordId          String?              @map("consent_record_id")
  consentDocumentVersion   String               @map("consent_document_version")
  inclusionReason          String               @map("inclusion_reason")
  status                   String               @default("pending")
  attempts                 Int                  @default(0)
  sentAt                   DateTime?            @map("sent_at")
  lastError                String?              @map("last_error")
  unsubscribedBeforeSendAt DateTime?            @map("unsubscribed_before_send_at")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  job                      TelegramBroadcastJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead                     Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  consentRecord            ConsentRecord?       @relation(fields: [consentRecordId], references: [id], onDelete: SetNull)

  @@unique([jobId, chatId])
  @@index([jobId, status, createdAt])
  @@index([leadId])
  @@index([consentRecordId])
  @@map("telegram_broadcast_recipients")
}

model TelegramBroadcastDeadLetter {
  id          String   @id @default(cuid())
  jobId       String   @unique @map("job_id")
  reason      String
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("telegram_broadcast_dead_letters")
}

model Question {
  id                         String              @id @default(cuid())
  leadId                     String              @map("lead_id")
  registrationId             String              @map("registration_id")
  webinarSessionId           String              @map("webinar_session_id")
  text                       String
  showToParticipants         Boolean             @default(false) @map("show_to_participants")
  displayMode                String              @default("pseudonym") @map("display_mode")
  publishedName              String?             @map("published_name")
  publicationConsentRecordId String?             @unique @map("publication_consent_record_id")
  isAnswered                 Boolean             @default(false) @map("is_answered")
  forwardedAt                DateTime?           @map("forwarded_at")
  adminNote                  String?             @map("admin_note")
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")
  lead                       Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  registration               Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  webinarSession             WebinarSession      @relation(fields: [webinarSessionId], references: [id], onDelete: Cascade)
  chatMessage                WebinarChatMessage?
  publicationConsentRecord   ConsentRecord?      @relation("QuestionPublicationConsent", fields: [publicationConsentRecordId], references: [id], onDelete: SetNull)
  consentRecords             ConsentRecord[]     @relation("QuestionConsentRecords")

  @@index([leadId])
  @@index([registrationId])
  @@index([webinarSessionId])
  @@index([createdAt])
  @@index([isAnswered])
  @@map("questions")
}

model ConsentRecord {
  id                  String                       @id @default(cuid())
  leadId              String?                      @map("lead_id")
  registrationId      String?                      @map("registration_id")
  questionId          String?                      @map("question_id")
  subjectRefHash      String                       @map("subject_ref_hash")
  kind                String
  action              String
  documentId          String                       @map("document_id")
  documentVersion     String                       @map("document_version")
  documentHash        String                       @map("document_hash")
  documentEffectiveAt DateTime                     @map("document_effective_at")
  purposes            Json
  dataCategories      Json                         @map("data_categories")
  operations          Json
  retentionTerm       String                       @map("retention_term")
  channels            Json
  sourceForm          String                       @map("source_form")
  ipHash              String?                      @map("ip_hash")
  userAgent           String?                      @map("user_agent")
  occurredAt          DateTime                     @default(now()) @map("occurred_at")
  revocationChannel   String?                      @map("revocation_channel")
  revocationReason    String?                      @map("revocation_reason")
  revokedConsentId    String?                      @map("revoked_consent_id")
  lead                Lead?                        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  registration        Registration?                @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  question            Question?                    @relation("QuestionConsentRecords", fields: [questionId], references: [id], onDelete: SetNull)
  revokedConsent      ConsentRecord?               @relation("ConsentRevocation", fields: [revokedConsentId], references: [id], onDelete: SetNull)
  revocations         ConsentRecord[]              @relation("ConsentRevocation")
  publishedQuestion   Question?                    @relation("QuestionPublicationConsent")
  broadcastRecipients TelegramBroadcastRecipient[]

  @@index([leadId, kind, occurredAt])
  @@index([registrationId, kind])
  @@index([questionId])
  @@index([documentId, documentVersion])
  @@index([revokedConsentId])
  @@map("consent_records")
}

model LegalAcceptance {
  id                  String        @id @default(cuid())
  leadId              String?       @map("lead_id")
  registrationId      String?       @map("registration_id")
  subjectRefHash      String        @map("subject_ref_hash")
  documentId          String        @map("document_id")
  documentVersion     String        @map("document_version")
  documentHash        String        @map("document_hash")
  documentEffectiveAt DateTime      @map("document_effective_at")
  sourceForm          String        @map("source_form")
  ipHash              String?       @map("ip_hash")
  userAgent           String?       @map("user_agent")
  acceptedAt          DateTime      @default(now()) @map("accepted_at")
  lead                Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  registration        Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([leadId, documentId, acceptedAt])
  @@index([registrationId])
  @@map("legal_acceptances")
}

model RetentionRun {
  id            String    @id @default(cuid())
  status        String
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  policyVersion String    @map("policy_version")
  cutoffJson    Json      @map("cutoff_json")
  resultJson    Json?     @map("result_json")
  error         String?

  @@index([startedAt])
  @@index([status, startedAt])
  @@map("retention_runs")
}

model WebinarChatMessage {
  id               String         @id @default(cuid())
  webinarSessionId String         @map("webinar_session_id")
  registrationId   String?        @map("registration_id")
  questionId       String?        @unique @map("question_id")
  kind             String
  authorName       String         @map("author_name")
  authorRole       String?        @map("author_role")
  message          String
  isSynthetic      Boolean        @default(false) @map("is_synthetic")
  visibleAt        DateTime       @default(now()) @map("visible_at")
  metadataJson     Json?          @map("metadata_json")
  createdAt        DateTime       @default(now()) @map("created_at")
  webinarSession   WebinarSession @relation(fields: [webinarSessionId], references: [id], onDelete: Cascade)
  registration     Registration?  @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  question         Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([webinarSessionId, visibleAt])
  @@index([registrationId])
  @@index([kind])
  @@map("webinar_chat_messages")
}

model Event {
  id               String          @id @default(cuid())
  eventName        String          @map("event_name")
  visitorId        String?         @map("visitor_id")
  leadId           String?         @map("lead_id")
  registrationId   String?         @map("registration_id")
  webinarSessionId String?         @map("webinar_session_id")
  page             String?
  source           String?
  utmSource        String?         @map("utm_source")
  utmMedium        String?         @map("utm_medium")
  utmCampaign      String?         @map("utm_campaign")
  userAgent        String?         @map("user_agent")
  ipHash           String?         @map("ip_hash")
  metadataJson     Json?           @map("metadata_json")
  createdAt        DateTime        @default(now()) @map("created_at")
  lead             Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  registration     Registration?   @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  webinarSession   WebinarSession? @relation(fields: [webinarSessionId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@index([visitorId, createdAt])
  @@index([visitorId, eventName, createdAt])
  @@index([eventName])
  @@index([createdAt])
  @@index([registrationId])
  @@index([leadId])
  @@index([webinarSessionId])
  @@index([source])
  @@index([utmSource])
  @@index([utmMedium])
  @@index([utmCampaign])
  @@map("events")
}

model PartnerApplication {
  id                String          @id @default(cuid())
  leadId            String          @map("lead_id")
  registrationId    String?         @map("registration_id")
  webinarSessionId  String?         @map("webinar_session_id")
  sphere            String?
  city              String?
  clientFlow        String?         @map("client_flow")
  experience        String?
  comment           String?
  preferredFormat   String?         @map("preferred_format")
  status            String          @default("new")
  assignedManagerId String?         @map("assigned_manager_id")
  nextContactAt     DateTime?       @map("next_contact_at")
  contractSentAt    DateTime?       @map("contract_sent_at")
  contractSignedAt  DateTime?       @map("contract_signed_at")
  lostReason        String?         @map("lost_reason")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  lead              Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  registration      Registration?   @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  webinarSession    WebinarSession? @relation(fields: [webinarSessionId], references: [id], onDelete: SetNull)
  assignedManager   AdminUser?      @relation(fields: [assignedManagerId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([registrationId])
  @@index([status])
  @@index([assignedManagerId])
  @@index([nextContactAt])
  @@index([createdAt])
  @@map("partner_applications")
}

model WebinarTimelineEvent {
  id               String          @id @default(cuid())
  webinarSessionId String?         @map("webinar_session_id")
  offsetSeconds    Int             @map("offset_seconds")
  title            String
  text             String
  type             String          @default("message")
  ctaLabel         String?         @map("cta_label")
  ctaUrl           String?         @map("cta_url")
  createdAt        DateTime        @default(now()) @map("created_at")
  webinarSession   WebinarSession? @relation(fields: [webinarSessionId], references: [id], onDelete: Cascade)

  @@index([webinarSessionId])
  @@index([offsetSeconds])
  @@map("webinar_timeline_events")
}

model TelegramNewsPost {
  id             String    @id @default(cuid())
  postKey        String    @unique @map("post_key")
  slotKey        String    @map("slot_key")
  title          String
  summary        String?
  url            String?
  sourceTitle    String?   @map("source_title")
  status         String    @default("sending")
  recipientCount Int       @default(0) @map("recipient_count")
  failedCount    Int       @default(0) @map("failed_count")
  lastError      String?   @map("last_error")
  sentAt         DateTime  @default(now()) @map("sent_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([slotKey])
  @@index([sentAt])
  @@map("telegram_news_posts")
}
