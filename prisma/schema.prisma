model EmailOutboxJob {
  id                     String          @id @default(cuid())
  type                   String
  status                 String          @default("pending")
  registrationId         String?         @map("registration_id")
  webinarSessionId       String?         @map("webinar_session_id")
  toEmail                String          @map("to_email")
  toName                 String          @map("to_name")
  scheduledAt            DateTime        @map("scheduled_at")
  webinarUrl             String          @map("webinar_url")
  partnerUrl             String?         @map("partner_url")
  reminderKind           String?         @map("reminder_kind")
  sessionScheduleVersion Int?            @map("session_schedule_version")
  attempts               Int             @default(0)
  lastError              String?         @map("last_error")
  nextAttemptAt          DateTime?       @map("next_attempt_at")
  sentAt                 DateTime?       @map("sent_at")
  claimToken             String?         @unique @map("claim_token")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
