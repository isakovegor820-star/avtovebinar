generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserKind {
  HUMAN  @map("human")
  SYSTEM @map("system")
}

enum UserStatus {
  PENDING     @map("pending")
  ACTIVE      @map("active")
  SUSPENDED   @map("suspended")
  DEACTIVATED @map("deactivated")
}

enum OrganizationStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ARCHIVED  @map("archived")
}

enum OrganizationMembershipRole {
  OWNER       @map("owner")
  AUTHOR      @map("author")
  MODERATOR   @map("moderator")
  CRM_MANAGER @map("crm_manager")
  ANALYST     @map("analyst")
  AUDITOR     @map("auditor")
}

enum OrganizationMembershipStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  REMOVED   @map("removed")
}

enum UserAuthTokenPurpose {
  PASSWORDLESS_LOGIN @map("passwordless_login")
}

enum UserAuthEmailJobStatus {
  PENDING     @map("pending")
  SENDING     @map("sending")
  SENT        @map("sent")
  FAILED      @map("failed")
  DEAD_LETTER @map("dead_letter")
  CANCELLED   @map("cancelled")
}

enum OrganizationInvitationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REVOKED  @map("revoked")
  EXPIRED  @map("expired")
}

enum AuthorVerificationStatus {
  DRAFT      @map("draft")
  PENDING    @map("pending")
  NEEDS_INFO @map("needs_info")
  VERIFIED   @map("verified")
  REJECTED   @map("rejected")
  SUSPENDED  @map("suspended")

  @@map("author_verification_status")
}

enum AuthorEvidenceKind {
  LICENSE        @map("license")
  DIPLOMA        @map("diploma")
  BAR_MEMBERSHIP @map("bar_membership")
  OTHER          @map("other")

  @@map("author_evidence_kind")
}

enum TaxonomyStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("taxonomy_status")
}

enum WebinarContentStatus {
  DRAFT         @map("draft")
  NEEDS_REVIEW  @map("needs_review")
  READY         @map("ready")
  IN_MODERATION @map("in_moderation")
  PUBLISHED     @map("published")
  ARCHIVED      @map("archived")

  @@map("webinar_content_status")
}

enum WebinarVisibility {
  PUBLIC   @map("public")
  UNLISTED @map("unlisted")
  PRIVATE  @map("private")

  @@map("webinar_visibility")
}

enum WebinarFreshnessStatus {
  CURRENT    @map("current")
  REVIEW_DUE @map("review_due")
  OUTDATED   @map("outdated")
  SUPERSEDED @map("superseded")
  UNKNOWN    @map("unknown")

  @@map("webinar_freshness_status")
}

enum WebinarAudienceLevel {
  INTRODUCTORY @map("introductory")
  PRACTITIONER @map("practitioner")
  ADVANCED     @map("advanced")
  ALL_LEVELS   @map("all_levels")

  @@map("webinar_audience_level")
}

enum WebinarFormat {
  RECORDED  @map("recorded")
  PREMIERE  @map("premiere")
  ON_DEMAND @map("on_demand")

  @@map("webinar_format")
}

enum WebinarMediaStatus {
  NOT_UPLOADED @map("not_uploaded")
  PROCESSING   @map("processing")
  READY        @map("ready")
  FAILED       @map("failed")

  @@map("webinar_media_status")
}

enum MediaAssetStatus {
  CREATED      @map("created")
  UPLOADING    @map("uploading")
  VALIDATING   @map("validating")
  TRANSCODING  @map("transcoding")
  TRANSCRIBING @map("transcribing")
  ENRICHING    @map("enriching")
  READY        @map("ready")
  FAILED       @map("failed")
  CANCELLED    @map("cancelled")

  @@map("media_asset_status")
}

enum MediaUploadStatus {
  CREATED   @map("created")
  UPLOADING @map("uploading")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("media_upload_status")
}

enum MediaJobStatus {
  PENDING     @map("pending")
  RUNNING     @map("running")
  SUCCEEDED   @map("succeeded")
  FAILED      @map("failed")
  DEAD_LETTER @map("dead_letter")
  CANCELLED   @map("cancelled")

  @@map("media_job_status")
}

enum WebinarTranscriptStatus {
  NOT_AVAILABLE @map("not_available")
  DRAFT         @map("draft")
  REVIEWED      @map("reviewed")
  PUBLISHED     @map("published")

  @@map("webinar_transcript_status")
}

enum AiSuggestionType {
  TITLE                @map("title")
  DESCRIPTION          @map("description")
  CHAPTER              @map("chapter")
  TAG                  @map("tag")
  PREPARED_QUESTION    @map("prepared_question")
  CHAT_MODERATOR_REPLY @map("chat_moderator_reply")

  @@map("ai_suggestion_type")
}

enum QuestionModerationStatus {
  NEW             @map("new")
  IN_REVIEW       @map("in_review")
  ACTION_REQUIRED @map("action_required")
  RESOLVED        @map("resolved")
  REJECTED        @map("rejected")

  @@map("question_moderation_status")
}

enum QuestionPriority {
  NORMAL @map("normal")
  HIGH   @map("high")

  @@map("question_priority")
}

enum AiSuggestionStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")

  @@map("ai_suggestion_status")
}

enum WebinarScenarioStatus {
  NOT_AVAILABLE @map("not_available")
  DRAFT         @map("draft")
  PUBLISHED     @map("published")

  @@map("webinar_scenario_status")
}

enum ChatScenarioMessageKind {
  PREPARED_QUESTION @map("prepared_question")
  MODERATOR_NOTICE  @map("moderator_notice")
  AUTHOR_PROMPT     @map("author_prompt")
  AI_MODERATOR      @map("ai_moderator")
  SYSTEM            @map("system")

  @@map("chat_scenario_message_kind")
}

enum ChatScenarioMessageStatus {
  DRAFT    @map("draft")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("chat_scenario_message_status")
}

enum WebinarChatMessageType {
  PARTICIPANT       @map("participant")
  MODERATOR         @map("moderator")
  PREPARED_QUESTION @map("prepared_question")
  AI_MODERATOR      @map("ai_moderator")
  SYSTEM            @map("system")

  @@map("webinar_chat_message_type")
}

enum WebinarSourceType {
  REGULATION            @map("regulation")
  STATUTE_PROVISION     @map("statute_provision")
  COURT_DECISION        @map("court_decision")
  OFFICIAL_GUIDANCE     @map("official_guidance")
  OFFICIAL_SOURCE       @map("official_source")
  TEMPLATE_OR_CHECKLIST @map("template_or_checklist")
  OTHER                 @map("other")

  @@map("webinar_source_type")
}

enum WebinarSessionLifecycleStatus {
  SCHEDULED @map("scheduled")
  ROOM_OPEN @map("room_open")
  LIVE      @map("live")
  REPLAY    @map("replay")
  CLOSED    @map("closed")
  CANCELLED @map("cancelled")

  @@map("webinar_session_lifecycle_status")
}

enum WebinarRecurrenceType {
  ONCE   @map("once")
  DAILY  @map("daily")
  WEEKLY @map("weekly")

  @@map("webinar_recurrence_type")
}

enum WebinarAccessPurpose {
  VIEW @map("view")

  @@map("webinar_access_purpose")
}

enum RegistrationAccessPolicy {
  LEGACY         @map("legacy")
  PUBLIC_CATALOG @map("public_catalog")
  PRIVATE_GRANT  @map("private_grant")

  @@map("registration_access_policy")
}

enum CRMPipelineStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("crm_pipeline_status")
}

enum CRMStageStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("crm_stage_status")
}

enum CRMStageSemanticCategory {
  OPEN @map("open")
  WON  @map("won")
  LOST @map("lost")

  @@map("crm_stage_semantic_category")
}

enum CRMTaskPriority {
  LOW    @map("low")
  NORMAL @map("normal")
  HIGH   @map("high")
  URGENT @map("urgent")

  @@map("crm_task_priority")
}

enum CRMTaskStatus {
  OPEN      @map("open")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("crm_task_status")
}

enum CRMScoringRuleSetStatus {
  DRAFT    @map("draft")
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("crm_scoring_rule_set_status")
}

enum CRMTagStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("crm_tag_status")
}

enum CRMBulkActionType {
  ASSIGN_MANAGER @map("assign_manager")
  CREATE_TASK    @map("create_task")
  CHANGE_STAGE   @map("change_stage")
  ADD_TAG        @map("add_tag")

  @@map("crm_bulk_action_type")
}

enum CRMBulkActionStatus {
  PREVIEWED @map("previewed")
  RUNNING   @map("running")
  COMPLETED @map("completed")
  PARTIAL   @map("partial")
  FAILED    @map("failed")
  EXPIRED   @map("expired")

  @@map("crm_bulk_action_status")
}

enum CRMDeliveryChannel {
  EMAIL    @map("email")
  TELEGRAM @map("telegram")

  @@map("crm_delivery_channel")
}

enum CRMDeliveryStatus {
  PENDING         @map("pending")
  SENDING         @map("sending")
  SENT            @map("sent")
  RETRY_SCHEDULED @map("retry_scheduled")
  BLOCKED         @map("blocked")
  DEAD_LETTER     @map("dead_letter")
  CANCELLED       @map("cancelled")

  @@map("crm_delivery_status")
}

enum TelegramManagerChatBindingStatus {
  PENDING_CHAT  @map("pending_chat")
  PENDING_OWNER @map("pending_owner")
  ACTIVE        @map("active")
  REVOKED       @map("revoked")
  EXPIRED       @map("expired")

  @@map("telegram_manager_chat_binding_status")
}

enum TelegramManagerCallbackAction {
  ACCEPT_CONTACT @map("accept_contact")
  CHANGE_STAGE   @map("change_stage")
  MARK_HOT       @map("mark_hot")
  CREATE_TASK    @map("create_task")

  @@map("telegram_manager_callback_action")
}

enum TelegramManagerCallbackStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  REJECTED  @map("rejected")
  EXPIRED   @map("expired")

  @@map("telegram_manager_callback_status")
}

enum TelegramBotIdentity {
  PARTICIPANT @map("participant")
  MANAGER     @map("manager")
  CONSULTANT  @map("consultant")
  OPERATIONAL @map("operational")

  @@map("telegram_bot_identity")
}

enum TelegramBotEventDirection {
  INBOUND  @map("inbound")
  OUTBOUND @map("outbound")
  INTERNAL @map("internal")

  @@map("telegram_bot_event_direction")
}

enum TelegramConsultantMessageStatus {
  NEW             @map("new")
  HANDED_TO_HUMAN @map("handed_to_human")
  RESOLVED        @map("resolved")

  @@map("telegram_consultant_message_status")
}

model User {
  id                               String                         @id @default(cuid())
  emailNormalized                  String                         @unique @map("email_normalized")
  displayName                      String?                        @map("display_name")
  kind                             UserKind                       @default(HUMAN)
  status                           UserStatus                     @default(PENDING)
  emailVerifiedAt                  DateTime?                      @map("email_verified_at")
  mfaSecretEncrypted               String?                        @map("mfa_secret_encrypted")
  mfaEnabledAt                     DateTime?                      @map("mfa_enabled_at")
  mfaEnrollmentExpiresAt           DateTime?                      @map("mfa_enrollment_expires_at")
  sessionVersion                   Int                            @default(1) @map("session_version")
  createdAt                        DateTime                       @default(now()) @map("created_at")
  updatedAt                        DateTime                       @updatedAt @map("updated_at")
  memberships                      OrganizationMembership[]
  membershipAudits                 AuditLog[]
  authTokens                       UserAuthToken[]
  sessions                         UserSession[]
  authEmailJobs                    UserAuthEmailJob[]
  invitationsSent                  OrganizationInvitation[]       @relation("OrganizationInvitationInviter")
  invitationsAccepted              OrganizationInvitation[]       @relation("OrganizationInvitationAcceptor")
  authorProfiles                   AuthorProfile[]
  authorVerificationsSubmitted     AuthorVerification[]           @relation("AuthorVerificationSubmitter")
  createdCrmTasks                  CRMTask[]                      @relation("CRMTaskCreator")
  webinarCommands                  WebinarCommand[]
  webinarSchedulesCreated          WebinarSchedule[]              @relation("WebinarScheduleCreator")
  webinarAccessGrants              WebinarAccessGrant[]           @relation("WebinarAccessGrantUser")
  webinarAccessGrantsInvited       WebinarAccessGrant[]           @relation("WebinarAccessGrantInviter")
  chatScenariosCreated             ChatScenario[]                 @relation("ChatScenarioCreator")
  chatScenariosApproved            ChatScenario[]                 @relation("ChatScenarioApprover")
  mediaAssetsCreated               MediaAsset[]                   @relation("MediaAssetCreator")
  transcriptsCreated               Transcript[]                   @relation("TranscriptCreator")
  transcriptsReviewed              Transcript[]                   @relation("TranscriptReviewer")
  contentJobsRequested             ContentJob[]                   @relation("ContentJobRequester")
  organizationTermsCreated         OrganizationTerm[]             @relation("OrganizationTermCreator")
  aiSuggestionsReviewed            AiSuggestion[]                 @relation("AiSuggestionReviewer")
  registrations                    Registration[]                 @relation("RegistrationParticipantUser")
  viewerFavorites                  ViewerWebinarFavorite[]
  viewerProgress                   ViewerWebinarProgress[]
  viewerNotes                      ViewerWebinarNote[]
  viewerNotificationPreferences    ViewerNotificationPreference[]
  telegramManagerBindingsRequested TelegramManagerChatBinding[]   @relation("TelegramManagerBindingRequester")
  telegramManagerBindingsConfirmed TelegramManagerChatBinding[]   @relation("TelegramManagerBindingConfirmer")
  telegramManagerBindingsRevoked   TelegramManagerChatBinding[]   @relation("TelegramManagerBindingRevoker")

  @@index([status])
  @@index([kind])
  @@map("users")
}

model Organization {
  id                            String                         @id @default(cuid())
  name                          String
  slug                          String                         @unique
  status                        OrganizationStatus             @default(ACTIVE)
  settingsJson                  Json?                          @map("settings_json")
  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @updatedAt @map("updated_at")
  memberships                   OrganizationMembership[]
  webinarSessions               WebinarSession[]
  auditLogs                     AuditLog[]
  activeSessions                UserSession[]                  @relation("UserSessionActiveOrganization")
  invitations                   OrganizationInvitation[]
  authorProfiles                AuthorProfile[]
  webinars                      Webinar[]
  webinarAliases                WebinarSlugAlias[]
  webinarSources                WebinarSource[]
  webinarCommands               WebinarCommand[]
  webinarSchedules              WebinarSchedule[]
  webinarAccessGrants           WebinarAccessGrant[]
  chatScenarios                 ChatScenario[]
  chatScenarioMessages          ChatScenarioMessage[]
  mediaAssets                   MediaAsset[]
  mediaUploads                  MediaUpload[]
  transcripts                   Transcript[]
  transcriptSegments            TranscriptSegment[]
  aiOperations                  AiOperationProvenance[]
  contentJobs                   ContentJob[]
  organizationTerms             OrganizationTerm[]
  aiSuggestions                 AiSuggestion[]
  webinarChapters               WebinarChapter[]
  webinarTags                   WebinarTag[]
  registrations                 Registration[]
  viewerFavorites               ViewerWebinarFavorite[]
  viewerProgress                ViewerWebinarProgress[]
  viewerNotes                   ViewerWebinarNote[]
  viewerNotificationPreferences ViewerNotificationPreference[]
  crmPipelines                  CRMPipeline[]
  crmStages                     CRMStage[]
  crmContacts                   CRMContact[]
  crmContactEvents              CRMContactEvent[]
  crmStageTransitions           CRMStageTransition[]
  crmTasks                      CRMTask[]
  crmScoringRuleSets            CRMScoringRuleSet[]
  crmScoringRules               CRMScoringRule[]
  crmScoreFactors               CRMScoreFactor[]
  crmTags                       CRMTag[]
  crmContactTags                CRMContactTag[]
  crmBulkActions                CRMBulkAction[]
  crmDeliveries                 CRMDelivery[]
  webinarChatMessages           WebinarChatMessage[]
  questions                     Question[]
  questionModerationEvents      QuestionModerationEvent[]
  telegramManagerChatBindings   TelegramManagerChatBinding[]
  telegramManagerCallbacks      TelegramManagerCallback[]
  telegramBotEvents             TelegramBotEvent[]
  telegramConsultantMessages    TelegramConsultantMessage[]

  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id                                String                       @id @default(cuid())
  organizationId                    String                       @map("organization_id")
  userId                            String                       @map("user_id")
  role                              OrganizationMembershipRole
  status                            OrganizationMembershipStatus @default(ACTIVE)
  permissionsJson                   Json?                        @map("permissions_json")
  joinedAt                          DateTime                     @default(now()) @map("joined_at")
  removedAt                         DateTime?                    @map("removed_at")
  createdAt                         DateTime                     @default(now()) @map("created_at")
  updatedAt                         DateTime                     @updatedAt @map("updated_at")
  organization                      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                              User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  acceptedInvitations               OrganizationInvitation[]
  ownedCrmContacts                  CRMContact[]                 @relation("CRMContactOwnerMembership")
  assignedCrmTasks                  CRMTask[]                    @relation("CRMTaskAssigneeMembership")
  manualHotContacts                 CRMContact[]                 @relation("CRMContactManualHotMembership")
  scoringRuleSetsCreated            CRMScoringRuleSet[]          @relation("CRMScoringRuleSetCreatorMembership")
  crmTagsCreated                    CRMTag[]                     @relation("CRMTagCreatorMembership")
  crmContactTagsAssigned            CRMContactTag[]              @relation("CRMContactTagAssignerMembership")
  crmBulkActionsRequested           CRMBulkAction[]              @relation("CRMBulkActionRequesterMembership")
  crmDeliveriesRequested            CRMDelivery[]                @relation("CRMDeliveryRequesterMembership")
  chatMessagesHidden                WebinarChatMessage[]         @relation("WebinarChatMessageHiddenByMembership")
  chatBansApplied                   Registration[]               @relation("RegistrationChatBannedByMembership")
  questionsHandled                  Question[]                   @relation("QuestionHandledByMembership")
  questionModerationEvents          QuestionModerationEvent[]
  telegramManagerChatBindings       TelegramManagerChatBinding[]
  telegramManagerCallbacks          TelegramManagerCallback[]
  telegramBotEvents                 TelegramBotEvent[]
  telegramConsultantMessagesHandled TelegramConsultantMessage[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId, status])
  @@index([organizationId, status, role])
  @@map("organization_memberships")
}

model UserAuthToken {
  id         String               @id @default(cuid())
  userId     String               @map("user_id")
  tokenHash  String               @unique @map("token_hash")
  purpose    UserAuthTokenPurpose
  expiresAt  DateTime             @map("expires_at")
  consumedAt DateTime?            @map("consumed_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
  @@map("user_auth_tokens")
}

model UserSession {
  id                   String        @id @default(cuid())
  userId               String        @map("user_id")
  tokenHash            String        @unique @map("token_hash")
  sessionVersion       Int           @map("session_version")
  activeOrganizationId String?       @map("active_organization_id")
  mfaVerifiedAt        DateTime?     @map("mfa_verified_at")
  expiresAt            DateTime      @map("expires_at")
  revokedAt            DateTime?     @map("revoked_at")
  lastSeenAt           DateTime      @default(now()) @map("last_seen_at")
  ipHash               String?       @map("ip_hash")
  userAgent            String?       @map("user_agent")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation("UserSessionActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([activeOrganizationId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserAuthEmailJob {
  id            String                 @id @default(cuid())
  userId        String                 @map("user_id")
  status        UserAuthEmailJobStatus @default(PENDING)
  attempts      Int                    @default(0)
  nextAttemptAt DateTime               @default(now()) @map("next_attempt_at")
  claimedAt     DateTime?              @map("claimed_at")
  claimToken    String?                @map("claim_token")
  sentAt        DateTime?              @map("sent_at")
  lastError     String?                @map("last_error")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId, status])
  @@map("user_auth_email_jobs")
}

model OrganizationInvitation {
  id               String                          @id @default(cuid())
  organizationId   String                          @map("organization_id")
  emailNormalized  String                          @map("email_normalized")
  role             OrganizationMembershipRole
  status           OrganizationInvitationStatus    @default(PENDING)
  expiresAt        DateTime                        @map("expires_at")
  invitedByUserId  String                          @map("invited_by_user_id")
  acceptedByUserId String?                         @map("accepted_by_user_id")
  membershipId     String?                         @map("membership_id")
  acceptedAt       DateTime?                       @map("accepted_at")
  revokedAt        DateTime?                       @map("revoked_at")
  createdAt        DateTime                        @default(now()) @map("created_at")
  updatedAt        DateTime                        @updatedAt @map("updated_at")
  organization     Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy        User                            @relation("OrganizationInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?                           @relation("OrganizationInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  membership       OrganizationMembership?         @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  tokens           OrganizationInvitationToken[]
  emailJob         OrganizationInvitationEmailJob?

  @@index([organizationId, status, expiresAt])
  @@index([emailNormalized, status])
  @@index([invitedByUserId])
  @@index([acceptedByUserId])
  @@map("organization_invitations")
}

model OrganizationInvitationToken {
  id            String                 @id @default(cuid())
  invitationId  String                 @map("invitation_id")
  tokenHash     String                 @unique @map("token_hash")
  expiresAt     DateTime               @map("expires_at")
  consumedAt    DateTime?              @map("consumed_at")
  invalidatedAt DateTime?              @map("invalidated_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  invitation    OrganizationInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, expiresAt])
  @@index([expiresAt])
  @@map("organization_invitation_tokens")
}

model OrganizationInvitationEmailJob {
  id            String                 @id @default(cuid())
  invitationId  String                 @unique @map("invitation_id")
  status        UserAuthEmailJobStatus @default(PENDING)
  attempts      Int                    @default(0)
  nextAttemptAt DateTime               @default(now()) @map("next_attempt_at")
  claimedAt     DateTime?              @map("claimed_at")
  claimToken    String?                @map("claim_token")
  sentAt        DateTime?              @map("sent_at")
  lastError     String?                @map("last_error")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  invitation    OrganizationInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("organization_invitation_email_jobs")
}

model AuthorProfile {
  id                       String                       @id @default(cuid())
  organizationId           String                       @map("organization_id")
  userId                   String                       @map("user_id")
  slug                     String                       @unique
  publicName               String?                      @map("public_name")
  bio                      String?
  specializations          String[]                     @default([])
  professionalOrganization String?                      @map("professional_organization")
  region                   String?
  experience               String?
  verificationStatus       AuthorVerificationStatus     @default(DRAFT) @map("verification_status")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  organization             Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                     User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  verifications            AuthorVerification[]
  evidence                 AuthorVerificationEvidence[]
  webinars                 Webinar[]

  @@unique([organizationId, userId])
