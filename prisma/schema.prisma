generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserKind {
  HUMAN  @map("human")
  SYSTEM @map("system")
}

enum UserStatus {
  PENDING     @map("pending")
  ACTIVE      @map("active")
  SUSPENDED   @map("suspended")
  DEACTIVATED @map("deactivated")
}

enum OrganizationStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ARCHIVED  @map("archived")
}

enum OrganizationMembershipRole {
  OWNER       @map("owner")
  AUTHOR      @map("author")
  MODERATOR   @map("moderator")
  CRM_MANAGER @map("crm_manager")
  ANALYST     @map("analyst")
  AUDITOR     @map("auditor")
}

enum OrganizationMembershipStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  REMOVED   @map("removed")
}

enum UserAuthTokenPurpose {
  PASSWORDLESS_LOGIN @map("passwordless_login")
}

enum UserAuthEmailJobStatus {
  PENDING     @map("pending")
  SENDING     @map("sending")
  SENT        @map("sent")
  FAILED      @map("failed")
  DEAD_LETTER @map("dead_letter")
  CANCELLED   @map("cancelled")
}

enum OrganizationInvitationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REVOKED  @map("revoked")
  EXPIRED  @map("expired")
}

enum AuthorVerificationStatus {
  DRAFT      @map("draft")
  PENDING    @map("pending")
  NEEDS_INFO @map("needs_info")
  VERIFIED   @map("verified")
  REJECTED   @map("rejected")
  SUSPENDED  @map("suspended")

  @@map("author_verification_status")
}

enum AuthorEvidenceKind {
  LICENSE        @map("license")
  DIPLOMA        @map("diploma")
  BAR_MEMBERSHIP @map("bar_membership")
  OTHER          @map("other")

  @@map("author_evidence_kind")
}

enum TaxonomyStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("taxonomy_status")
}

enum WebinarContentStatus {
  DRAFT         @map("draft")
  NEEDS_REVIEW  @map("needs_review")
  READY         @map("ready")
  IN_MODERATION @map("in_moderation")
  PUBLISHED     @map("published")
  ARCHIVED      @map("archived")

  @@map("webinar_content_status")
}

enum WebinarVisibility {
  PUBLIC   @map("public")
  UNLISTED @map("unlisted")
  PRIVATE  @map("private")

  @@map("webinar_visibility")
}

enum WebinarFreshnessStatus {
  CURRENT    @map("current")
  REVIEW_DUE @map("review_due")
  OUTDATED   @map("outdated")
  SUPERSEDED @map("superseded")
  UNKNOWN    @map("unknown")

  @@map("webinar_freshness_status")
}

enum WebinarAudienceLevel {
  INTRODUCTORY @map("introductory")
  PRACTITIONER @map("practitioner")
  ADVANCED     @map("advanced")
  ALL_LEVELS   @map("all_levels")

  @@map("webinar_audience_level")
}

enum WebinarFormat {
  RECORDED  @map("recorded")
  PREMIERE  @map("premiere")
  ON_DEMAND @map("on_demand")

  @@map("webinar_format")
}

enum WebinarMediaStatus {
  NOT_UPLOADED @map("not_uploaded")
  PROCESSING   @map("processing")
  READY        @map("ready")
  FAILED       @map("failed")

  @@map("webinar_media_status")
}

enum WebinarTranscriptStatus {
  NOT_AVAILABLE @map("not_available")
  DRAFT         @map("draft")
  REVIEWED      @map("reviewed")
  PUBLISHED     @map("published")

  @@map("webinar_transcript_status")
}

enum WebinarScenarioStatus {
  NOT_AVAILABLE @map("not_available")
  DRAFT         @map("draft")
  PUBLISHED     @map("published")

  @@map("webinar_scenario_status")
}

enum WebinarSourceType {
  REGULATION            @map("regulation")
  STATUTE_PROVISION     @map("statute_provision")
  COURT_DECISION        @map("court_decision")
  OFFICIAL_GUIDANCE     @map("official_guidance")
  OFFICIAL_SOURCE       @map("official_source")
  TEMPLATE_OR_CHECKLIST @map("template_or_checklist")
  OTHER                 @map("other")

  @@map("webinar_source_type")
}

enum WebinarSessionLifecycleStatus {
  SCHEDULED @map("scheduled")
  ROOM_OPEN @map("room_open")
  LIVE      @map("live")
  REPLAY    @map("replay")
  CLOSED    @map("closed")
  CANCELLED @map("cancelled")

  @@map("webinar_session_lifecycle_status")
}

enum WebinarRecurrenceType {
  ONCE   @map("once")
  DAILY  @map("daily")
  WEEKLY @map("weekly")

  @@map("webinar_recurrence_type")
}

model User {
  id                           String                   @id @default(cuid())
  emailNormalized              String                   @unique @map("email_normalized")
  displayName                  String?                  @map("display_name")
  kind                         UserKind                 @default(HUMAN)
  status                       UserStatus               @default(PENDING)
  emailVerifiedAt              DateTime?                @map("email_verified_at")
  mfaSecretEncrypted           String?                  @map("mfa_secret_encrypted")
  mfaEnabledAt                 DateTime?                @map("mfa_enabled_at")
  mfaEnrollmentExpiresAt       DateTime?                @map("mfa_enrollment_expires_at")
  sessionVersion               Int                      @default(1) @map("session_version")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  memberships                  OrganizationMembership[]
  membershipAudits             AuditLog[]
  authTokens                   UserAuthToken[]
  sessions                     UserSession[]
  authEmailJobs                UserAuthEmailJob[]
  invitationsSent              OrganizationInvitation[] @relation("OrganizationInvitationInviter")
  invitationsAccepted          OrganizationInvitation[] @relation("OrganizationInvitationAcceptor")
  authorProfiles               AuthorProfile[]
  authorVerificationsSubmitted AuthorVerification[]     @relation("AuthorVerificationSubmitter")
  webinarCommands              WebinarCommand[]
  webinarSchedulesCreated      WebinarSchedule[]        @relation("WebinarScheduleCreator")

  @@index([status])
  @@index([kind])
  @@map("users")
}

model Organization {
  id               String                   @id @default(cuid())
  name             String
  slug             String                   @unique
  status           OrganizationStatus       @default(ACTIVE)
  settingsJson     Json?                    @map("settings_json")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  memberships      OrganizationMembership[]
  webinarSessions  WebinarSession[]
  auditLogs        AuditLog[]
  activeSessions   UserSession[]            @relation("UserSessionActiveOrganization")
  invitations      OrganizationInvitation[]
  authorProfiles   AuthorProfile[]
  webinars         Webinar[]
  webinarAliases   WebinarSlugAlias[]
  webinarSources   WebinarSource[]
  webinarCommands  WebinarCommand[]
  webinarSchedules WebinarSchedule[]

  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id                  String                       @id @default(cuid())
  organizationId      String                       @map("organization_id")
  userId              String                       @map("user_id")
  role                OrganizationMembershipRole
  status              OrganizationMembershipStatus @default(ACTIVE)
  permissionsJson     Json?                        @map("permissions_json")
  joinedAt            DateTime                     @default(now()) @map("joined_at")
  removedAt           DateTime?                    @map("removed_at")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  acceptedInvitations OrganizationInvitation[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
  @@map("organization_memberships")
}

model UserAuthToken {
  id         String               @id @default(cuid())
  userId     String               @map("user_id")
  tokenHash  String               @unique @map("token_hash")
  purpose    UserAuthTokenPurpose
  expiresAt  DateTime             @map("expires_at")
  consumedAt DateTime?            @map("consumed_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
  @@map("user_auth_tokens")
}

model UserSession {
  id                   String        @id @default(cuid())
  userId               String        @map("user_id")
  tokenHash            String        @unique @map("token_hash")
  sessionVersion       Int           @map("session_version")
  activeOrganizationId String?       @map("active_organization_id")
  mfaVerifiedAt        DateTime?     @map("mfa_verified_at")
  expiresAt            DateTime      @map("expires_at")
  revokedAt            DateTime?     @map("revoked_at")
  lastSeenAt           DateTime      @default(now()) @map("last_seen_at")
  ipHash               String?       @map("ip_hash")
  userAgent            String?       @map("user_agent")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation("UserSessionActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([activeOrganizationId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserAuthEmailJob {
  id            String                 @id @default(cuid())
  userId        String                 @map("user_id")
  status        UserAuthEmailJobStatus @default(PENDING)
  attempts      Int                    @default(0)
  nextAttemptAt DateTime               @default(now()) @map("next_attempt_at")
  claimedAt     DateTime?              @map("claimed_at")
  claimToken    String?                @map("claim_token")
  sentAt        DateTime?              @map("sent_at")
  lastError     String?                @map("last_error")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId, status])
  @@map("user_auth_email_jobs")
}

model OrganizationInvitation {
  id               String                          @id @default(cuid())
  organizationId   String                          @map("organization_id")
  emailNormalized  String                          @map("email_normalized")
  role             OrganizationMembershipRole
  status           OrganizationInvitationStatus    @default(PENDING)
  expiresAt        DateTime                        @map("expires_at")
  invitedByUserId  String                          @map("invited_by_user_id")
  acceptedByUserId String?                         @map("accepted_by_user_id")
  membershipId     String?                         @map("membership_id")
  acceptedAt       DateTime?                       @map("accepted_at")
  revokedAt        DateTime?                       @map("revoked_at")
  createdAt        DateTime                        @default(now()) @map("created_at")
  updatedAt        DateTime                        @updatedAt @map("updated_at")
  organization     Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy        User                            @relation("OrganizationInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?                           @relation("OrganizationInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  membership       OrganizationMembership?         @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  tokens           OrganizationInvitationToken[]
  emailJob         OrganizationInvitationEmailJob?

  @@index([organizationId, status, expiresAt])
  @@index([emailNormalized, status])
  @@index([invitedByUserId])
  @@index([acceptedByUserId])
  @@map("organization_invitations")
}

model OrganizationInvitationToken {
  id            String                 @id @default(cuid())
  invitationId  String                 @map("invitation_id")
  tokenHash     String                 @unique @map("token_hash")
  expiresAt     DateTime               @map("expires_at")
  consumedAt    DateTime?              @map("consumed_at")
  invalidatedAt DateTime?              @map("invalidated_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  invitation    OrganizationInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, expiresAt])
  @@index([expiresAt])
  @@map("organization_invitation_tokens")
}

model OrganizationInvitationEmailJob {
  id            String                 @id @default(cuid())
  invitationId  String                 @unique @map("invitation_id")
  status        UserAuthEmailJobStatus @default(PENDING)
  attempts      Int                    @default(0)
  nextAttemptAt DateTime               @default(now()) @map("next_attempt_at")
  claimedAt     DateTime?              @map("claimed_at")
  claimToken    String?                @map("claim_token")
  sentAt        DateTime?              @map("sent_at")
  lastError     String?                @map("last_error")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  invitation    OrganizationInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("organization_invitation_email_jobs")
}

model AuthorProfile {
  id                       String                       @id @default(cuid())
  organizationId           String                       @map("organization_id")
  userId                   String                       @map("user_id")
  slug                     String                       @unique
  publicName               String?                      @map("public_name")
  bio                      String?
  specializations          String[]                     @default([])
  professionalOrganization String?                      @map("professional_organization")
  region                   String?
  experience               String?
  verificationStatus       AuthorVerificationStatus     @default(DRAFT) @map("verification_status")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  organization             Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                     User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  verifications            AuthorVerification[]
  evidence                 AuthorVerificationEvidence[]
  webinars                 Webinar[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([organizationId, verificationStatus])
  @@index([userId])
  @@map("author_profiles")
}

model AuthorVerification {
  id                    String                       @id @default(cuid())
  profileId             String                       @map("profile_id")
  organizationId        String                       @map("organization_id")
  status                AuthorVerificationStatus     @default(PENDING)
  submittedByUserId     String                       @map("submitted_by_user_id")
  reviewedByAdminUserId String?                      @map("reviewed_by_admin_user_id")
  publicComment         String?                      @map("public_comment")
  internalReason        String?                      @map("internal_reason")
  submittedAt           DateTime                     @default(now()) @map("submitted_at")
  reviewedAt            DateTime?                    @map("reviewed_at")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
  profile               AuthorProfile                @relation(fields: [profileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  submittedBy           User                         @relation("AuthorVerificationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy            AdminUser?                   @relation(fields: [reviewedByAdminUserId], references: [id], onDelete: Restrict)
  evidence              AuthorVerificationEvidence[]

  @@unique([id, organizationId])
  @@index([organizationId, status, submittedAt])
  @@index([profileId, submittedAt])
  @@index([reviewedByAdminUserId])
  @@map("author_verifications")
}

model AuthorVerificationEvidence {
  id             String              @id @default(cuid())
  profileId      String              @map("profile_id")
  organizationId String              @map("organization_id")
  verificationId String?             @map("verification_id")
  kind           AuthorEvidenceKind
  originalName   String              @map("original_name")
  mimeType       String              @map("mime_type")
  sizeBytes      Int                 @map("size_bytes")
  checksumSha256 String              @map("checksum_sha256")
  content        Bytes
  createdAt      DateTime            @default(now()) @map("created_at")
  profile        AuthorProfile       @relation(fields: [profileId, organizationId], references: [id, organizationId], onDelete: Cascade)
  verification   AuthorVerification? @relation(fields: [verificationId], references: [id], onDelete: Restrict)

  @@index([profileId, createdAt])
  @@index([organizationId, verificationId])
  @@map("author_verification_evidence")
}

model LegalPracticeArea {
  id         String                @id @default(cuid())
  parentId   String?               @map("parent_id")
  slug       String                @unique
  name       String
  status     TaxonomyStatus        @default(ACTIVE)
  orderIndex Int                   @default(0) @map("order_index")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  parent     LegalPracticeArea?    @relation("PracticeAreaTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   LegalPracticeArea[]   @relation("PracticeAreaTree")
  webinars   WebinarPracticeArea[]

  @@index([parentId, status, orderIndex])
  @@index([status, orderIndex])
  @@map("legal_practice_areas")
}

model Jurisdiction {
  id        String         @id @default(cuid())
  parentId  String?        @map("parent_id")
  code      String         @unique
  name      String
  status    TaxonomyStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  parent    Jurisdiction?  @relation("JurisdictionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Jurisdiction[] @relation("JurisdictionTree")
  webinars  Webinar[]

  @@index([parentId, status])
  @@index([status, name])
  @@map("jurisdictions")
}

model Webinar {
  id                    String                  @id @default(cuid())
  organizationId        String                  @map("organization_id")
  authorProfileId       String?                 @map("author_profile_id")
  jurisdictionId        String?                 @map("jurisdiction_id")
  slug                  String
  title                 String
  description           String?
  outcomeDescription    String?                 @map("outcome_description")
  contentStatus         WebinarContentStatus    @default(DRAFT) @map("content_status")
  visibility            WebinarVisibility       @default(PRIVATE)
  freshnessStatus       WebinarFreshnessStatus  @default(UNKNOWN) @map("freshness_status")
  audienceLevel         WebinarAudienceLevel?   @map("audience_level")
  targetAudience        String?                 @map("target_audience")
  format                WebinarFormat?
  durationMinutes       Int?                    @map("duration_minutes")
  language              String                  @default("ru")
  currentAsOf           DateTime?               @map("current_as_of") @db.Date
  disclaimer            String?
  syntheticDisclosure   String?                 @map("synthetic_disclosure")
  mediaStatus           WebinarMediaStatus      @default(NOT_UPLOADED) @map("media_status")
  transcriptStatus      WebinarTranscriptStatus @default(NOT_AVAILABLE) @map("transcript_status")
  scenarioStatus        WebinarScenarioStatus   @default(NOT_AVAILABLE) @map("scenario_status")
  contentVersion        Int                     @default(1) @map("content_version")
  supersededByWebinarId String?                 @map("superseded_by_webinar_id")
  legacyCompatibility   Boolean                 @default(false) @map("legacy_compatibility")
  publishedAt           DateTime?               @map("published_at")
  archivedAt            DateTime?               @map("archived_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authorProfile         AuthorProfile?          @relation(fields: [authorProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  jurisdiction          Jurisdiction?           @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  supersededBy          Webinar?                @relation("WebinarSupersession", fields: [supersededByWebinarId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supersedes            Webinar[]               @relation("WebinarSupersession")
  practiceAreas         WebinarPracticeArea[]
  sources               WebinarSource[]
  slugAliases           WebinarSlugAlias[]
  sessions              WebinarSession[]
  schedules             WebinarSchedule[]
  commands              WebinarCommand[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, contentStatus, updatedAt])
  @@index([authorProfileId, contentStatus])
  @@index([jurisdictionId, contentStatus])
  @@index([visibility, contentStatus, publishedAt])
  @@index([supersededByWebinarId])
  @@map("webinars")
}

model WebinarPracticeArea {
  webinarId      String            @map("webinar_id")
  organizationId String            @map("organization_id")
  practiceAreaId String            @map("practice_area_id")
  isPrimary      Boolean           @default(false) @map("is_primary")
  createdAt      DateTime          @default(now()) @map("created_at")
  webinar        Webinar           @relation(fields: [webinarId, organizationId], references: [id, organizationId], onDelete: Cascade)
  practiceArea   LegalPracticeArea @relation(fields: [practiceAreaId], references: [id], onDelete: Restrict)

  @@id([webinarId, practiceAreaId])
  @@index([organizationId, practiceAreaId])
  @@index([practiceAreaId, isPrimary])
  @@map("webinar_practice_areas")
}

model WebinarSource {
  id             String            @id @default(cuid())
  webinarId      String            @map("webinar_id")
  organizationId String            @map("organization_id")
  type           WebinarSourceType
  title          String
  url            String?
  accessedAt     DateTime?         @map("accessed_at") @db.Date
  note           String?
  orderIndex     Int               @default(0) @map("order_index")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  webinar        Webinar           @relation(fields: [webinarId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([webinarId, orderIndex])
  @@index([organizationId, type])
  @@map("webinar_sources")
}

model WebinarSlugAlias {
  id             String       @id @default(cuid())
  webinarId      String       @map("webinar_id")
  organizationId String       @map("organization_id")
  slug           String
  createdAt      DateTime     @default(now()) @map("created_at")
  webinar        Webinar      @relation(fields: [webinarId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, slug])
  @@index([webinarId, createdAt])
  @@map("webinar_slug_aliases")
}

model WebinarCommand {
  id             String       @id @default(cuid())
  webinarId      String       @map("webinar_id")
  organizationId String       @map("organization_id")
  requestedById  String       @map("requested_by_id")
  action         String
  idempotencyKey String       @map("idempotency_key")
  resultStatus   String       @map("result_status")
  createdAt      DateTime     @default(now()) @map("created_at")
  webinar        Webinar      @relation(fields: [webinarId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy    User         @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, action, idempotencyKey])
  @@index([webinarId, action, createdAt])
  @@index([requestedById, createdAt])
  @@map("webinar_commands")
}

model WebinarSchedule {
  id                 String                @id @default(cuid())
  webinarId          String                @map("webinar_id")
  organizationId     String                @map("organization_id")
  createdById        String                @map("created_by_id")
  recurrenceType     WebinarRecurrenceType @map("recurrence_type")
  timezone           String
  localStartTime     String                @map("local_start_time")
  startsOn           DateTime              @map("starts_on") @db.Date
  endsOn             DateTime?             @map("ends_on") @db.Date
  maxFutureInstances Int                   @default(30) @map("max_future_instances")
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  webinar            Webinar               @relation(fields: [webinarId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy          User                  @relation("WebinarScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sessions           WebinarSession[]

  @@unique([webinarId])
  @@unique([id, organizationId])
  @@index([organizationId, active, startsOn])
  @@index([createdById, createdAt])
  @@map("webinar_schedules")
}

model AdminUser {
  id                          String                 @id @default(cuid())
  name                        String
  email                       String                 @unique
  passwordHash                String                 @map("password_hash")
  role                        String                 @default("manager")
