NODE_ENV=production
PORT=5174
PUBLIC_SITE_URL=https://example.com
CORS_ORIGIN=https://example.com

POSTGRES_USER=aspb
POSTGRES_PASSWORD=
POSTGRES_DB=aspb_autowebinar
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aspb_autowebinar?schema=public&connection_limit=10&pool_timeout=20
# Optional dedicated libpq URL. Prefer this for host backup/restore when its
# SSL options differ; never add Prisma-only connection_limit/pool_timeout here.
PG_DATABASE_URL=

ADMIN_LOGIN=owner@example.com
ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=
IP_HASH_SECRET=
# Stable independent HMAC secret for private Webinar invitee email hashes.
WEBINAR_ACCESS_HASH_SECRET=
METRICS_TOKEN=

EMAIL_MODE=send
E2E_EMAIL_OUTBOX_ENABLED=off
# Keep off until staging acceptance. Current Docker self-hosted path: local_fs;
# S3 remains an optional future provider requiring separate approval.
MEDIA_STORAGE_PROVIDER=unconfigured
MEDIA_LOCAL_ROOT=/var/lib/aspb/media
MEDIA_S3_ENDPOINT=https://storage.yandexcloud.net
MEDIA_S3_REGION=ru-central1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
MEDIA_SIGNED_OPERATION_TTL_SECONDS=900
MEDIA_TRANSCODE_TIMEOUT_SECONDS=7200
MEDIA_HLS_SEGMENT_SECONDS=6
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_WORK_ROOT=/var/lib/aspb/media-work
MEDIA_PROCESSING_SPACE_MULTIPLIER=4
MEDIA_PROCESSING_RESERVE_BYTES=1073741824
MEDIA_MIN_FREE_INODES=10000
MEDIA_WORKER_CONCURRENCY=1
CONTENT_WORKER_CONCURRENCY=1
MEDIA_QUEUE_ALERT_THRESHOLD=100
CONTENT_QUEUE_ALERT_THRESHOLD=100
STT_PROVIDER=unconfigured
STT_YANDEX_API_KEY=
STT_YANDEX_FOLDER_ID=
STT_YANDEX_ENDPOINT=https://stt.api.cloud.yandex.net/stt/v3/recognizeFileAsync
STT_YANDEX_OPERATION_ENDPOINT=https://stt.api.cloud.yandex.net/operations
STT_YANDEX_RESULT_ENDPOINT=https://stt.api.cloud.yandex.net/stt/v3/getRecognition
STT_YANDEX_DELETE_ENDPOINT=https://stt.api.cloud.yandex.net/stt/v3/deleteRecognition
STT_YANDEX_AUDIO_URI_PREFIX=
STT_YANDEX_MODEL=general
STT_YANDEX_POLL_INTERVAL_MS=3000
STT_YANDEX_TIMEOUT_SECONDS=7200
AI_ENRICHMENT_PROVIDER=unconfigured
AI_YANDEX_API_KEY=
AI_YANDEX_FOLDER_ID=
AI_YANDEX_MODEL_URI=
AI_YANDEX_ENDPOINT=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
AI_YANDEX_TIMEOUT_SECONDS=120
MEDIA_MAX_UPLOAD_BYTES=4294967296
MATERIAL_MAX_UPLOAD_BYTES=104857600
MEDIA_MAX_DURATION_SECONDS=10800
MEDIA_PART_SIZE_BYTES=8388608
# Comma-separated HTTPS origins used only for direct browser uploads (no paths).
# Yandex virtual-hosted example: https://<bucket>.storage.yandexcloud.net
MEDIA_UPLOAD_CSP_ORIGINS=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="АСПБ <no-reply@example.com>"
EMAIL_REPLY_TO=partners@example.com

TELEGRAM_GROUP_URL=https://t.me/jwjefgwreqfe_bot

TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_OPERATIONAL_CHAT_ID=
TELEGRAM_ADMIN_BOT_POLLING=on
TELEGRAM_NOTIFY_MODE=send
TELEGRAM_CALLBACK_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_POLLING=off

TELEGRAM_PARTICIPANT_BOT_TOKEN=
TELEGRAM_PARTICIPANT_BOT_USERNAME=jwjefgwreqfe_bot
TELEGRAM_EXPECTED_PARTICIPANT_BOT_USERNAME=jwjefgwreqfe_bot
TELEGRAM_PARTICIPANT_BOT_POLLING=on

TELEGRAM_CONSULTANT_BOT_TOKEN=
TELEGRAM_CONSULTANT_BOT_USERNAME=
TELEGRAM_CONSULTANT_BOT_POLLING=off

TELEGRAM_NEWS_BROADCAST=off
# Включать только после проверки Telegram-согласий, уведомления о трансграничной передаче и письменного разрешения.
TELEGRAM_MANUAL_BROADCAST=off
TELEGRAM_NEWS_TIMES=09:00,11:30,14:00,16:30,19:00
TELEGRAM_NEWS_RSS_URLS=https://www.consultant.ru/rss/hotdocs.xml,https://www.consultant.ru/rss/nw.xml,https://www.consultant.ru/rss/db.xml

WEBINAR_VIDEO_PROVIDER=hls
WEBINAR_VIDEO_HLS_URL=https://cdn.example.com/webinar/master.m3u8
WEBINAR_VIDEO_URL=https://private-cdn.example.com/webinar/webinar.mp4
WEBINAR_POSTER_URL=https://cdn.example.com/webinar/poster.jpg
WEBINAR_MEDIA_ORIGIN_TOKEN=
WEBINAR_VIDEO_DURATION_SECONDS=3860
# Existing same-origin webinar/replay files. The deploy gate requires a
# dedicated absolute directory; it is mounted read-only into the public assets path.
LEGACY_MEDIA_PATH=/srv/aspb/legacy-media

WEBINAR_TEST_ROOM_MODE=off
WORKER_ROLE=api
TRUST_PROXY=1

# Expand/switch flags: legacy registration, room, CRM and /admin stay active while off.
PLATFORM_ACCOUNTS_ENABLED=off
ASPB_SINGLE_ORGANIZATION_MODE=on
PLATFORM_TENANCY_ENFORCEMENT=off
CREATOR_DASHBOARD_ENABLED=off
PUBLIC_CATALOG_ENABLED=off
TENANT_CRM_ENABLED=off
TENANT_TELEGRAM_BOTS_ENABLED=off

# Ограничение локального роста диска. Docker Compose читает эти значения через
# `--env-file .env.production`; backup-скрипт использует 30 дней по умолчанию.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
# Global BuildKit cache is shared by every project on the Docker daemon.
# Keep this off unless the host/builder is dedicated to АСПБ and the operator
# explicitly accepts cross-project cache eviction.
DOCKER_BUILD_CACHE_PRUNE=off
DOCKER_BUILD_CACHE_MAX_AGE=168h
BACKUP_RETENTION_DAYS=30
RETENTION_APPLY_ENABLED=off
