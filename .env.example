NODE_ENV=development
PORT=5174
PUBLIC_SITE_URL=http://127.0.0.1:5174
DATABASE_URL=postgresql://aspb:aspb@localhost:5432/aspb_autowebinar?schema=public&connection_limit=10&pool_timeout=20
# Optional libpq-only URL for host pg_dump/psql. If empty, scripts safely
# normalize DATABASE_URL and remove Prisma-only query parameters.
PG_DATABASE_URL=
POSTGRES_USER=aspb
POSTGRES_PASSWORD=
POSTGRES_DB=aspb_autowebinar

# Первый owner-админ создается из этих значений при seed/login, дальше менеджеры живут в БД.
# Секреты не имеют безопасных дефолтов в коде: задайте локальные значения перед запуском.
ADMIN_LOGIN=admin@example.com
ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=
IP_HASH_SECRET=
# Set a stable independent secret before enabling private Webinar grants.
# If omitted, compatibility mode derives hashes from ADMIN_COOKIE_SECRET.
WEBINAR_ACCESS_HASH_SECRET=
METRICS_TOKEN=

# development: log, production: send
EMAIL_MODE=log
# Test runner only: enqueue for fake delivery without enabling SMTP.
E2E_EMAIL_OUTBOX_ENABLED=off
MEDIA_STORAGE_PROVIDER=unconfigured
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=ru-central1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
MEDIA_SIGNED_OPERATION_TTL_SECONDS=900
MEDIA_TRANSCODE_TIMEOUT_SECONDS=7200
MEDIA_HLS_SEGMENT_SECONDS=6
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_FFPROBE_PATH=ffprobe
STT_PROVIDER=unconfigured
STT_YANDEX_API_KEY=
STT_YANDEX_FOLDER_ID=
STT_YANDEX_ENDPOINT=https://stt.api.cloud.yandex.net/stt/v3/recognizeFileAsync
STT_YANDEX_OPERATION_ENDPOINT=https://stt.api.cloud.yandex.net/operations
STT_YANDEX_RESULT_ENDPOINT=https://stt.api.cloud.yandex.net/stt/v3/getRecognition
STT_YANDEX_DELETE_ENDPOINT=https://stt.api.cloud.yandex.net/stt/v3/deleteRecognition
STT_YANDEX_AUDIO_URI_PREFIX=
STT_YANDEX_MODEL=general
STT_YANDEX_POLL_INTERVAL_MS=3000
STT_YANDEX_TIMEOUT_SECONDS=7200
AI_ENRICHMENT_PROVIDER=unconfigured
AI_YANDEX_API_KEY=
AI_YANDEX_FOLDER_ID=
AI_YANDEX_MODEL_URI=
AI_YANDEX_ENDPOINT=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
AI_YANDEX_TIMEOUT_SECONDS=120
MEDIA_MAX_UPLOAD_BYTES=4294967296
MEDIA_MAX_DURATION_SECONDS=10800
MEDIA_PART_SIZE_BYTES=8388608
# Для virtual-hosted S3 URL укажите origin вида https://<bucket>.storage.yandexcloud.net.
MEDIA_UPLOAD_CSP_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="АСПБ <no-reply@aspb.local>"
EMAIL_REPLY_TO=

TELEGRAM_GROUP_URL=https://t.me/jwjefgwreqfe_bot

# Бот для менеджера: получает новые регистрации, вопросы и заявки.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_BOT_POLLING=off
TELEGRAM_NOTIFY_MODE=log

# Legacy fallback. Лучше не использовать для нового запуска, оставлено для совместимости.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_POLLING=off

# Бот для участников: /start по персональной ссылке, новости и напоминания.
TELEGRAM_PARTICIPANT_BOT_TOKEN=
TELEGRAM_PARTICIPANT_BOT_USERNAME=jwjefgwreqfe_bot
TELEGRAM_EXPECTED_PARTICIPANT_BOT_USERNAME=jwjefgwreqfe_bot
TELEGRAM_PARTICIPANT_BOT_POLLING=off

# Бот-консультант: первичные вопросы, команды /webinar, /partner, /contact.
TELEGRAM_CONSULTANT_BOT_TOKEN=
TELEGRAM_CONSULTANT_BOT_USERNAME=
TELEGRAM_CONSULTANT_BOT_POLLING=off

# 5 новостных/полезных Telegram-выпусков в день для подключенных участников.
TELEGRAM_NEWS_BROADCAST=off
# Ручная рекламная рассылка остаётся выключенной до письменного разрешения руководителя.
TELEGRAM_MANUAL_BROADCAST=off
TELEGRAM_NEWS_TIMES=09:00,11:30,14:00,16:30,19:00
TELEGRAM_NEWS_RSS_URLS=https://www.consultant.ru/rss/hotdocs.xml,https://www.consultant.ru/rss/nw.xml,https://www.consultant.ru/rss/db.xml

# Видео вебинара. HLS имеет приоритет; браузер получает только защищённый /api/media URL.
# В production origin должен требовать WEBINAR_MEDIA_ORIGIN_TOKEN. Локальный fallback — только для dev.
WEBINAR_VIDEO_PROVIDER=local
WEBINAR_VIDEO_HLS_URL=
WEBINAR_VIDEO_URL=
WEBINAR_POSTER_URL=
WEBINAR_MEDIA_ORIGIN_TOKEN=
WEBINAR_VIDEO_DURATION_SECONDS=3860

# Dev-only: открывает вебинарную комнату всегда и запускает видео с начала после обновления.
WEBINAR_TEST_ROOM_MODE=off
CORS_ORIGIN=http://127.0.0.1:5174
WORKER_ROLE=all
TRUST_PROXY=false

# Tenant foundation rollout. Keep off until user passwordless sessions are enabled.
PLATFORM_ACCOUNTS_ENABLED=off
PLATFORM_TENANCY_ENFORCEMENT=off
CREATOR_DASHBOARD_ENABLED=off
PUBLIC_CATALOG_ENABLED=off

# Локальные значения безопасны для разработки; production может переопределить их.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
DOCKER_BUILD_CACHE_PRUNE=off
DOCKER_BUILD_CACHE_MAX_AGE=168h
BACKUP_RETENTION_DAYS=30
