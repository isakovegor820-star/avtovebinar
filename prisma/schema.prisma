  webinarSession         WebinarSession? @relation(fields: [webinarSessionId], references: [id], onDelete: SetNull)

  // Не больше одной email-джобы на registration/type/kind/версию расписания.
  // NULL в reminderKind/version для прочих legacy jobs не меняет их прежнюю семантику Postgres.
  @@unique([registrationId, type, reminderKind, sessionScheduleVersion])
  @@index([status, nextAttemptAt, createdAt])
  @@index([registrationId])
  @@index([webinarSessionId])
  @@index([type])
  @@map("email_outbox_jobs")
}

